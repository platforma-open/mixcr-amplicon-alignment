// The memory grant of the `exportClones` steps. The MiXCR steps of a run take theirs from
// :resources.

exec := import("@platforma-sdk/workflow-tengo:exec")

math := import("math")

f := exec.formula

// exportRam builds the exec.formula node for an `exportClones` step.
//
//     ram = max(interceptGiB + perByte x size("clns"), floorGiB)
//
// exportClones reads the whole CloneSet into heap and applies --chains after that read, so
// the request tracks the .clns and not the exported field set. Every caller must tag its
// .clns input `{ tag: "clns" }`; size("clns") reads file metadata through getBlobSize.
//
// Measured on five generic-amplicon samples, .clns 0.13 to 1.31 GiB:
//     export peak = 6.4 + 25.0 x clns_GiB     (R2 0.970)
// perByte 30 is that slope divided by the 0.85 heap share of `memory-from-limits`.
//
// There is no ceiling. The backend clamps a request to the node maximum.
//
// perProcessMemGB is the "Advanced Settings" override. It raises the floor and does not
// replace the rule: a value below floorGiB has no effect, and the data term still applies
// above a raised floor. A planned shard of :aggregate-by-clonotype-key ignores the override;
// see :shard-plan.
exportRamInterceptGiB := 8

exportRam := func(perProcessMemGB, floorGiB, perByte) {
	floor := floorGiB
	if !is_undefined(perProcessMemGB) {
		floor = int(math.max(perProcessMemGB, floorGiB))
	}
	return f.gib(exportRamInterceptGiB).
		plus(f.size("clns").times(perByte)).
		atLeast(f.gib(floor)).
		staticFallback(f.gib(floor))
}

export {
	exportRam: exportRam
}
